[Unit]
Description=Mahjong multiplayer server
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/mahjong-server
ExecStart=/usr/local/bin/node /opt/mahjong-server/server/index.js
Environment=PORT=3001
Environment=HOST=0.0.0.0
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
